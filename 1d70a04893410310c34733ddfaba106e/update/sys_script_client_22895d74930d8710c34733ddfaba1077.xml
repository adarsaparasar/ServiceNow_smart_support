        <name>Faulty Asset Alert</name>
        <order/>
        <script><![CDATA[function onLoad() {

    var assetId = g_form.getValue('asset');

    // ✅ Exit if no asset
    if (!assetId) {
        return;
    }

    // ✅ Client-side fetch of asset record
    g_form.getReference('asset', function(asset) {

        if (!asset) {
            return;
        }

        // ✅ Check if asset is Faulty
        if (asset.status == 'Faulty') {

            // ✅ Popup alert (with button)
            alert('⚠️ Selected Asset is Faulty!');
        }
    });
}]]></script>
