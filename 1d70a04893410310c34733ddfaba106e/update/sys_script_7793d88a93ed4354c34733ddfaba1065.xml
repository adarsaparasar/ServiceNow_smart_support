        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var groupMembers = [];
    
    // 1. Query the Group Member table for active users in the given group
    var grMember = new GlideRecord('sys_user_grmember');
    grMember.addQuery('group', current.assignment_group);
    grMember.addQuery('user.active', true); // Ensures the user is active
    grMember.query();
    
    // 2. Push all found User Sys IDs into an array
    while (grMember.next()) {
        groupMembers.push(grMember.user.toString());
    }
    
    // 3. Randomly assign a user if the array is not empty
    if (groupMembers.length > 0) {
        var randomIndex = Math.floor(Math.random() * groupMembers.length);
        current.assigned_to = groupMembers[randomIndex];
    } else {
        current.assigned_to = ''; // Clear assignee if no active members
    }

})(current, previous);
]]></script>
