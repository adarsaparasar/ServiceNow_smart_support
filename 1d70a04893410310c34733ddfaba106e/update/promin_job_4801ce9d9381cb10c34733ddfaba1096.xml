        <condition><![CDATA[var gr = new GlideRecord('x_1558402_smart_0_request_tracker');

gr.addQuery('status', 'Failed');
gr.addQuery('retry_count', '<', 3);
gr.query();

while (gr.next()) {

    try {

        var payload = JSON.parse(gr.payload);

        var eventLogGR = new GlideRecord('x_1558402_smart_0_external_event_id');
        eventLogGR.initialize();
        eventLogGR.event_id = payload.event_id;
        eventLogGR.payload = gr.payload;
        eventLogGR.status = 'Pending';
        eventLogGR.insert();

        gr.status = 'Success';

    } catch (e) {

        gr.retry_count = gr.retry_count + 1;
        gr.last_error = e.message;

        if (gr.retry_count >= 3) {
            gr.status = 'Failed Permanent';
        }

    }

    gr.update();
}]]></condition>
